# Store the real file only at /etc/kalam-design/gateway.env with mode 0600.
KALAM_TELEGRAM_BOT_TOKEN=replace-with-the-BotFather-token-of-the-reporter-bot
KALAM_OWNER_TELEGRAM_ID=605598559
KALAM_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/design-request
KALAM_N8N_SHARED_SECRET=generate-a-long-random-value
KALAM_DATA_DIR=/var/lib/kalam-design
KALAM_N8N_API_URL=https://n8n.kalametazenews.ir/api/v1
KALAM_N8N_API_KEY=replace-with-an-n8n-api-key
KALAM_N8N_REPORTER_WORKFLOW_ID=OHXw52fzQvoY88OS
# Base URL of the four manual News Seeker webhooks. The gateway appends
# /all, /google_trends, /local or /khabarfarsi when an editor requests data.
KALAM_N8N_NEWS_SEEKER_WEBHOOK_URL=http://127.0.0.1:5678/webhook/news-seeker
# n8n must expose this same internal URL to the Archive nodes in News Seeker.
KALAM_NEWS_SEEKER_INGEST_URL=http://127.0.0.1:8091/news-seeker/ingest
# A shared result is reused during this window, avoiding duplicate feed runs.
KALAM_NEWS_SEEKER_MIN_REFRESH_SECONDS=1200
