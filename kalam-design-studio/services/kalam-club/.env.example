# Database
CLUB_DATABASE_URL=postgresql+psycopg://kalam_club:change-me@postgres:5432/kalam_club

# Member sessions and internal Studio-to-Club requests. Generate unique random
# values on the server and never expose them to either browser bundle.
CLUB_SESSION_SECRET=replace-with-64-random-bytes
CLUB_INTERNAL_SIGNING_SECRET=replace-with-64-random-bytes
CLUB_FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key

# National SMS gateway (MeliPayamak). These values reuse the verified contract
# from D:\kalamapp, but must be supplied only in the deployment environment.
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_SENDER_NUMBER=
MELIPAYAMAK_OTP_MODE=soap
MELIPAYAMAK_OTP_SOAP_URL=https://api.payamak-panel.com/post/Send.asmx/SendOtp
MELIPAYAMAK_OTP_URL=https://rest.payamak-panel.com/api/SendSMS/SendOtp
MELIPAYAMAK_SMS_URL=https://api.payamak-panel.com/post/send.asmx/SendSimpleSMS2

# Private S3-compatible storage. Browser uploads use short-lived multipart
# URLs, so these credentials remain server-only.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=true
CLUB_S3_PREFIX=kalam-club/v1
# "proxy" is the secure default when the bucket credentials cannot manage CORS.
# It still transfers resumable 8 MB multipart segments and supports 300 MB files.
CLUB_UPLOAD_TRANSPORT=proxy

# Files remain quarantined until this internal ClamAV service reports them clean.
CLUB_CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=180

# Public deployment settings
CLUB_PUBLIC_ORIGIN=https://club.kalametaze.ir
CLUB_CORS_ORIGINS=https://club.kalametaze.ir,https://studio.kalametazenews.ir
CLUB_MAX_UPLOAD_BYTES=314572800
CLUB_OTP_TTL_SECONDS=300
CLUB_OTP_RESEND_SECONDS=90
CLUB_OTP_MAX_ATTEMPTS=5
